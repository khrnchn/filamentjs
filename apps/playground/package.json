{
  "name": "@filamentjs/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "better-auth generate --output src/db/auth-schema.ts",
    "test": "vitest run",
    "make:user": "tsx scripts/make-user.ts"
  },
  "dependencies": {
    "@filamentjs/core": "workspace:^",
    "@filamentjs/forms": "workspace:^",
    "@filamentjs/infolists": "workspace:^",
    "@filamentjs/panels": "workspace:^",
    "@filamentjs/tables": "workspace:^",
    "@radix-ui/react-checkbox": "^1.3.10",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-label": "^2.1.14",
    "@radix-ui/react-select": "^2.3.6",
    "@radix-ui/react-slot": "^1.3.2",
    "@radix-ui/react-switch": "^1.3.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.26.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^2.1.0"
  }
}
